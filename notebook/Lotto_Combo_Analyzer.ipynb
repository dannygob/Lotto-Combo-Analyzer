# Lotto Combo Analyzer - Main Notebook

# 📦 Import modules
import pandas as pd
from src.preprocessing import load_dataset, extract_combo_columns, clean_numeric_columns, sort_combinations, prepare_history_set
from src.analysis import (
    calculate_frequency, plot_top_frequencies,
    add_sum_column, plot_sum_distribution, describe_sum_statistics,
    add_differential_column, plot_differential_distribution,
    classify_changes, plot_change_classification
)
from src.clustering import apply_kmeans, plot_elbow_method, plot_cluster_distribution
from src.modeling import prepare_sequences, build_lstm_model, optimize_lstm, cross_validate_model, predict_combination
from src.comparison import prepare_classification_data, train_random_forest, train_xgboost, compare_models
from src.evaluation import evaluate_group_accuracy, print_group_accuracy_report
from src.simulation import simulate_multiple_combinations, print_simulation_results
from src.association import prepare_transactions, encode_transactions, apply_apriori, generate_rules, plot_lift_distribution

# 📁 Load and preprocess data
df = load_dataset("data/lotto_history.csv")
combo_cols = extract_combo_columns(df)
df = clean_numeric_columns(df, combo_cols)
df_sorted = sort_combinations(df, combo_cols)
history_set = prepare_history_set(df_sorted)

# 📊 Statistical analysis
freq_df = calculate_frequency(df, combo_cols)
plot_top_frequencies(freq_df)
df = add_sum_column(df, combo_cols)
plot_sum_distribution(df)
describe_sum_statistics(df)
df = add_differential_column(df)
plot_differential_distribution(df)
df = classify_changes(df)
plot_change_classification(df)

# 🔍 Clustering
plot_elbow_method(df, combo_cols)
df["Cluster"] = apply_kmeans(df, combo_cols, n_clusters=5)
plot_cluster_distribution(df)

# 🧠 LSTM modeling
flat_data = df[combo_cols].values.flatten().tolist()
X, y_cat = prepare_sequences(flat_data, look_back=5, num_classes=52)
best_params = optimize_lstm(X, y_cat, look_back=5, num_classes=52, n_trials=20)
metrics_df = cross_validate_model(X, y_cat, best_params, look_back=5, num_classes=52)
print(metrics_df.describe())

# 🎯 Predict single combination
model = build_lstm_model(best_params["units"], look_back=5, num_classes=52, lr=best_params["lr"])
model.fit(X, y_cat, epochs=20, batch_size=32, verbose=0)
combo_pred = predict_combination(model, X[-1], combo_size=6, history_set=history_set)
print("🔮 Predicted Combination:", combo_pred)

# 🎲 Simulate multiple combinations
simulations = simulate_multiple_combinations(model, X[-1], combo_size=6, history_set=history_set, num_simulations=10)
print_simulation_results(simulations)

# 🧪 Evaluate group accuracy
actual_combos = df_sorted.tolist()
metrics = evaluate_group_accuracy(simulations, actual_combos)
print_group_accuracy_report(metrics)

# 🔁 Compare with other models
X_clf, y_clf = prepare_classification_data(flat_data, look_back=5, num_classes=52)
rf_metrics = train_random_forest(X_clf, y_clf)
xgb_metrics = train_xgboost(X_clf, y_clf)
compare_models(rf_metrics, xgb_metrics)

# 🔗 Association rules
transactions = prepare_transactions(df, combo_cols)
df_encoded = encode_transactions(transactions)
frequent_itemsets = apply_apriori(df_encoded, min_support=0.01)
rules = generate_rules(frequent_itemsets, min_confidence=0.3, min_lift=1.0)
plot_lift_distribution(rules)
print("📌 Top Association Rules:")
print(rules[['antecedents', 'consequents', 'support', 'confidence', 'lift']].head(10))
