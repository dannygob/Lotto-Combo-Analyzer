# Ignore Python cache and compiled files
__pycache__/
*.py[cod]
*.so

# Ignore Jupyter notebook checkpoints
.ipynb_checkpoints/

# Ignore virtual environments
venv/
env/
.venv/
ENV/

# Ignore system files
.DS_Store
Thumbs.db

# Ignore data and results (optional)
data/*.csv
results/*.csv

# Ignore model files and logs
*.h5
*.log
*.ckpt
*.pth
*.pt

# Ignore IDE settings
.vscode/
.idea/

# Ignore temporary files
*.tmp
*.bak
*.swp
